---
export const prerender = false;

import Layout from "../layouts/Layout.astro";
import FindCampusCta from "../components/FindCampusCta.astro";
import FaqAccordion from "../components/FaqAccordion.astro";
import { sanityClient } from "../lib/sanity";
import { ADMISSIONS_PAGE_QUERY, FAQS_BY_TOPIC_QUERY } from "../lib/queries";

const fallback = {
  heading: "Admissions.",
  intro: "At Illuminate Montessori, we believe the admissions journey should be clear, welcoming, and inspiring.",
  steps: [
    { title: "Schedule a Tour or Visit", description: "See our classrooms in action, meet our educators, and experience the Montessori environment firsthand." },
    { title: "Confirm Placement", description: "Based on your child's age and stage of development, our admissions team will guide you into the right program." },
    { title: "Complete Registration", description: "Submit the New Student Registration Form along with a one-time application fee and tuition deposit." },
  ],
  teamEmail: "hello@illuminatemontessori.com",
  toursHeading: "Tours and Open Houses",
  toursIntro: "We host open houses, personal tours, and community events throughout the year, giving families the chance to:",
  toursList: ["Explore classrooms and outdoor learning spaces.", "Meet guides, staff, and current families.", "Learn how Montessori builds independence, focus, and joy.", "Ask questions about curriculum, routines, and school life."],
  focusHeading: "Our core focus in the admissions process.",
  focusIntro: "Enrolling at Illuminate Montessori means joining a partnership built on transparency, visibility, and progress.",
  focusItems: [
    { title: "Stability", description: "Every placement is planned with care, ensuring a consistent environment where your child feels safe and supported." },
    { title: "Community", description: "From your first tour to your child's first day, you'll feel the warmth of our community." },
    { title: "Staff", description: "Our Montessori-trained educators focus on outcomes that matter most: independence, concentration, and joy." },
    { title: "Curriculum", description: "Our curriculum is hands-on, screen-free, and outcome-driven." },
    { title: "Classrooms", description: "Every space is designed for independence." },
    { title: "Visibility", description: "Our parent app provides updates, photos, and progress snapshots so you stay connected." },
  ],
  referralHeading: "Referral Program",
  referralText: "Our schools thrive on community. When you refer a family who enrolls, you'll receive a school specific tuition credit as our thank-you.",
  faqs: [{ question: "When do you accept new students?", answer: "We offer rolling enrollment year-round, with most placements happening for the fall start." }],
  closingText: "We look forward to welcoming your family into our community — one child, one classroom, one future at a time.",
};

const data = sanityClient ? ((await sanityClient.fetch(ADMISSIONS_PAGE_QUERY)) ?? fallback) : fallback;

const faqs = sanityClient
  ? ((await sanityClient.fetch(FAQS_BY_TOPIC_QUERY, { topic: "admissions" })) ?? [])
  : [];
const answeredFaqs = faqs.filter((f: any) => f.answer?.trim());
const faqSchema = answeredFaqs.length
  ? {
      "@context": "https://schema.org",
      "@type": "FAQPage",
      mainEntity: answeredFaqs.map((f: any) => ({
        "@type": "Question",
        name: f.question,
        acceptedAnswer: { "@type": "Answer", text: f.answer },
      })),
    }
  : undefined;
---

<Layout
  title="Admissions"
  metaTitle="Admissions & Enrollment | Illuminate Montessori"
  description="Tour, confirm placement, enroll. A clear, transparent admissions process for Nido, Toddler, and Children's House programs across our campuses."
  schema={faqSchema}
>
  <section class="bg-cream">
    <div class="mx-auto max-w-3xl px-6 lg:px-8 pt-16 pb-14 text-center">
      <h1 class="font-serif text-4xl sm:text-5xl text-ink leading-tight">{data.heading}</h1>
      <p class="mt-5 text-slate leading-relaxed">{data.intro}</p>
      <FindCampusCta class="mt-8" />
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-6 lg:px-8 py-16">
    <h2 class="text-center font-serif text-3xl text-ink mb-10">How to Apply</h2>
    <div class="grid gap-6 sm:grid-cols-3">
      {data.steps.map((step: any, i: number) => (
        <div class="rounded-2xl border border-black/5 p-6">
          <span class="font-serif text-2xl text-teal-300">{i + 1}</span>
          <h3 class="mt-3 font-medium text-ink">{step.title}</h3>
          <p class="mt-2 text-sm leading-relaxed text-slate">{step.description}</p>
        </div>
      ))}
    </div>
    <p class="mt-8 text-center text-sm text-slate">
      Our Admissions Team is here to help at every step — <a href={`mailto:${data.teamEmail}`} class="text-teal-500 font-medium">{data.teamEmail}</a>
    </p>
  </section>

  <section class="bg-teal-light">
    <div class="mx-auto max-w-4xl px-6 lg:px-8 py-16">
      <h2 class="font-serif text-3xl text-ink text-center">{data.toursHeading}</h2>
      <p class="mt-4 text-center text-slate max-w-2xl mx-auto">{data.toursIntro}</p>
      <ul class="mt-8 grid gap-3 sm:grid-cols-2 max-w-2xl mx-auto">
        {data.toursList.map((t: string) => (
          <li class="flex items-start gap-3 text-sm text-slate bg-white rounded-lg px-4 py-3">
            <span class="mt-1.5 h-1.5 w-1.5 flex-shrink-0 rounded-full bg-teal-400"></span>
            {t}
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-6 lg:px-8 py-20">
    <h2 class="text-center font-serif text-3xl text-ink">{data.focusHeading}</h2>
    <p class="mt-4 text-center max-w-2xl mx-auto text-slate leading-relaxed">{data.focusIntro}</p>
    <div class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {data.focusItems.map((item: any) => (
        <div>
          <h3 class="font-serif text-lg text-ink">{item.title}</h3>
          <p class="mt-2 text-sm leading-relaxed text-slate">{item.description}</p>
        </div>
      ))}
    </div>
  </section>

  <section class="bg-cream">
    <div class="mx-auto max-w-3xl px-6 lg:px-8 py-14 text-center">
      <h2 class="font-serif text-2xl text-ink">{data.referralHeading}</h2>
      <p class="mt-3 text-slate leading-relaxed">{data.referralText}</p>
    </div>
  </section>

  {answeredFaqs.length > 0 && (
    <section class="mx-auto max-w-3xl px-6 lg:px-8 py-16">
      <h2 class="font-serif text-3xl text-ink text-center mb-8">Frequently Asked Questions</h2>
      <FaqAccordion faqs={answeredFaqs} />
    </section>
  )}

  <section class="bg-teal-500">
    <div class="mx-auto max-w-3xl px-6 lg:px-8 py-16 text-center">
      <p class="font-serif text-2xl sm:text-3xl text-white">{data.closingText}</p>
      <a href="/our-schools/" class="mt-8 inline-flex items-center rounded-full bg-white px-8 py-3.5 text-sm font-semibold text-teal-600 hover:bg-cream transition-colors">
        Find a School Near You
      </a>
    </div>
  </section>
</Layout>
