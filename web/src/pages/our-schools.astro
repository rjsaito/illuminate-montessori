---
export const prerender = false;

import Layout from "../layouts/Layout.astro";
import CampusFinder from "../components/CampusFinder.astro";
import { sanityClient } from "../lib/sanity";
import { OUR_SCHOOLS_PAGE_QUERY, ALL_PROGRAMS_QUERY } from "../lib/queries";
import { getAllCampuses } from "../lib/campuses";

const fallback = {
  eyebrow: "Find Your Campus",
  heading: "A Place Families Trust, and Children Love",
  subheading: "Delivering the Best Montessori Education in America",
};

const data = sanityClient ? ((await sanityClient.fetch(OUR_SCHOOLS_PAGE_QUERY)) ?? fallback) : fallback;
const allCampuses = await getAllCampuses();
const programs = sanityClient ? ((await sanityClient.fetch(ALL_PROGRAMS_QUERY)) ?? []) : [];

// Programs that at least one campus actually offers — no dead filter chips.
const offered = new Set(allCampuses.flatMap((c) => (c.programs ?? []).map((p: any) => p.slug)));
const filterPrograms = programs.filter((p: any) => offered.has(p.slug));

const byState = ["Virginia", "Massachusetts", "Texas"].map((r) => ({
  region: r,
  count: allCampuses.filter((c) => c.region === r).length,
}));
const summary = byState.filter((s) => s.count > 0).map((s) => `${s.count} in ${s.region}`).join(", ");

const schema = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  name: "Illuminate Montessori campuses",
  numberOfItems: allCampuses.length,
  itemListElement: allCampuses.map((c, i) => ({
    "@type": "ListItem",
    position: i + 1,
    url: new URL(`/${c.slug}/`, Astro.site).href,
    name: `Illuminate Montessori at ${c.name}`,
  })),
};
---

<Layout
  title="Our Schools"
  metaTitle="Find a Montessori School Near You | Illuminate Montessori"
  description={`Find an Illuminate Montessori campus near you — ${allCampuses.length} schools (${summary}). Filter by program and age, or search by ZIP code.`}
  schema={schema}
>
  <section class="bg-cream">
    <div class="mx-auto max-w-3xl px-6 lg:px-8 pt-16 pb-14 text-center">
      <p class="text-xs font-semibold tracking-[0.2em] text-teal-500 uppercase">{data.eyebrow}</p>
      <h1 class="mt-4 font-serif text-4xl sm:text-5xl text-ink leading-tight">{data.heading}</h1>
      <p class="mt-4 text-slate">{data.subheading}</p>
      <p class="mt-3 text-sm text-slate">{allCampuses.length} campuses — {summary}</p>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-6 lg:px-8 py-12">
    <CampusFinder campuses={allCampuses} programs={filterPrograms} />
  </section>
</Layout>
