---
export const prerender = false;

import Layout from "../layouts/Layout.astro";
import { getCampusBySlug } from "../lib/campuses";

const { campus: slug } = Astro.params;
const campus = slug ? await getCampusBySlug(slug) : null;

// Unknown slug must be a real 404, not a redirect — redirects read as soft-404s.
if (!campus) {
  return new Response(null, { status: 404, statusText: "Not Found" });
}

const stateAbbr: Record<string, string> = { Virginia: "VA", Massachusetts: "MA", Texas: "TX" };
const stateLabel = stateAbbr[campus.region] ?? campus.region;

// Pull "City, ST" out of the address when it's present, for the title tag.
const cityMatch = campus.address?.match(/,\s*([A-Za-z .]+),\s*([A-Z]{2})\s*\d{5}/);
const cityState = cityMatch ? `${cityMatch[1].trim()}, ${cityMatch[2]}` : `${campus.name}, ${stateLabel}`;

const description = `Illuminate Montessori at ${campus.name} — authentic Montessori education in ${cityState}. Schedule a weekday tour, see hours, and contact our team.`;

const schema: Record<string, any> = {
  "@context": "https://schema.org",
  "@type": "School",
  name: `Illuminate Montessori at ${campus.name}`,
  url: new URL(`/${campus.slug}/`, Astro.site).href,
  description: campus.about?.slice(0, 300),
  ...(campus.phone ? { telephone: campus.phone } : {}),
  ...(campus.email ? { email: campus.email } : {}),
  ...(campus.heroImageUrl ? { image: campus.heroImageUrl } : {}),
  ...(campus.address
    ? {
        address: {
          "@type": "PostalAddress",
          streetAddress: campus.address,
          addressRegion: stateLabel,
          addressCountry: "US",
        },
      }
    : {}),
  ...(campus.hours
    ? {
        openingHoursSpecification: {
          "@type": "OpeningHoursSpecification",
          dayOfWeek: ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday"],
          opens: "07:00",
          closes: "18:00",
        },
      }
    : {}),
  parentOrganization: { "@type": "EducationalOrganization", name: "Illuminate Montessori" },
};

const mapsHref = campus.address
  ? `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(campus.address)}`
  : null;
---

<Layout
  title={campus.name}
  metaTitle={`Montessori Preschool in ${cityState} | Illuminate Montessori ${campus.name}`}
  description={description}
  ogImage={campus.heroImageUrl ?? "/images/core/home-hero.jpeg"}
  schema={schema}
>
  <section class="bg-cream">
    <div class="mx-auto max-w-6xl px-6 lg:px-8 pt-16 pb-16 grid gap-10 lg:grid-cols-2 items-center">
      <div>
        <p class="text-xs font-semibold tracking-[0.2em] text-teal-500 uppercase">{campus.name}, {stateLabel}</p>
        <h1 class="mt-4 font-serif text-4xl sm:text-5xl text-ink leading-tight">
          Illuminate Montessori
          <br />
          at {campus.name}
        </h1>
        <a href="#tour" class="mt-6 inline-flex items-center rounded-full bg-teal-400 px-7 py-3 text-sm font-medium text-white hover:bg-teal-500 transition-colors">
          Schedule a Tour
        </a>

        <dl class="mt-10 grid gap-5 sm:grid-cols-2">
          {campus.address && (
            <div>
              <dt class="text-xs font-semibold tracking-wider text-ink uppercase">Visit</dt>
              <dd class="mt-1 text-sm text-slate">
                <a href={mapsHref} target="_blank" rel="noopener noreferrer" class="hover:text-teal-500">{campus.address}</a>
              </dd>
            </div>
          )}
          {campus.phone && (
            <div>
              <dt class="text-xs font-semibold tracking-wider text-ink uppercase">Call</dt>
              <dd class="mt-1 text-sm text-slate"><a href={`tel:${campus.phone.replace(/[^0-9+]/g, "")}`} class="hover:text-teal-500">{campus.phone}</a></dd>
            </div>
          )}
          {campus.email && (
            <div>
              <dt class="text-xs font-semibold tracking-wider text-ink uppercase">Email</dt>
              <dd class="mt-1 text-sm text-slate break-all"><a href={`mailto:${campus.email.trim()}`} class="hover:text-teal-500">{campus.email.trim()}</a></dd>
            </div>
          )}
          {campus.hours && (
            <div>
              <dt class="text-xs font-semibold tracking-wider text-ink uppercase">Operating Hours</dt>
              <dd class="mt-1 text-sm text-slate">{campus.hours}</dd>
            </div>
          )}
        </dl>
      </div>

      {campus.heroImageUrl ? (
        <img
          src={campus.heroImageUrl}
          alt={`Illuminate Montessori at ${campus.name}`}
          width="900"
          height="384"
          class="rounded-2xl w-full h-96 object-cover"
        />
      ) : (
        <div class="rounded-2xl w-full h-96 bg-teal-light flex items-center justify-center">
          <img src="/images/core/logo-illuminate.png" alt="" width="80" height="80" class="h-20 w-auto opacity-60" />
        </div>
      )}
    </div>
  </section>

  {campus.about && (
    <section class="mx-auto max-w-3xl px-6 lg:px-8 py-16">
      <h2 class="font-serif text-2xl text-ink mb-4">About This Campus</h2>
      {campus.about.split("\n\n").filter(Boolean).map((p: string) => (
        <p class="text-slate leading-relaxed mb-4">{p}</p>
      ))}
    </section>
  )}

  <section id="tour" class="bg-cream scroll-mt-20">
    <div class="mx-auto max-w-2xl px-6 lg:px-8 py-16 text-center">
      <h2 class="font-serif text-2xl text-ink">Schedule Your Visit to {campus.name}</h2>
      <p class="mt-3 text-slate">See our prepared environment for yourself. We host weekday tours by appointment.</p>
      {campus.bookingIframeUrl ? (
        <div class="mt-8 rounded-2xl overflow-hidden bg-teal-500">
          <iframe
            src={campus.bookingIframeUrl}
            class="w-full"
            style="height: 680px; border: none; display: block;"
            title={`Schedule a tour at ${campus.name}`}
            loading="lazy"
          />
        </div>
      ) : (
        <a href="/contact/" class="mt-8 inline-flex items-center rounded-full bg-teal-400 px-7 py-3 text-sm font-medium text-white hover:bg-teal-500 transition-colors">
          Schedule a Tour
        </a>
      )}
    </div>
  </section>
</Layout>
