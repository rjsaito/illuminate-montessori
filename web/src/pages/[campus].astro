---
export const prerender = false;

import Layout from "../layouts/Layout.astro";
import { getCampusBySlug } from "../lib/campuses";

const { campus: slug } = Astro.params;
const campus = slug ? await getCampusBySlug(slug) : null;

if (!campus) {
  return new Response(null, { status: 404, statusText: "Not Found" });
}

const stateAbbr: Record<string, string> = { Virginia: "VA", Massachusetts: "MA", Texas: "TX" };
const stateLabel = stateAbbr[campus.region] ?? campus.region;
const cityState = campus.city ? `${campus.city}, ${stateLabel}` : `${campus.name}, ${stateLabel}`;

const description = `Illuminate Montessori at ${campus.name} — authentic Montessori education in ${cityState}${
  campus.agesServed ? ` for ages ${campus.agesServed}` : ""
}. Schedule a weekday tour.`;

const hos = campus.headOfSchool;
const programs = campus.programs ?? [];

const breadcrumb = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Campuses", item: new URL("/our-schools/", Astro.site).href },
    { "@type": "ListItem", position: 2, name: campus.name, item: new URL(`/${campus.slug}/`, Astro.site).href },
  ],
};

const schema: Record<string, any> = {
  "@context": "https://schema.org",
  "@type": "School",
  name: `Illuminate Montessori at ${campus.name}`,
  url: new URL(`/${campus.slug}/`, Astro.site).href,
  description: campus.about?.slice(0, 300),
  ...(campus.phone ? { telephone: campus.phone } : {}),
  ...(campus.email ? { email: campus.email } : {}),
  ...(campus.heroImageUrl ? { image: campus.heroImageUrl } : {}),
  ...(campus.address
    ? {
        address: {
          "@type": "PostalAddress",
          streetAddress: campus.address,
          ...(campus.city ? { addressLocality: campus.city } : {}),
          addressRegion: stateLabel,
          ...(campus.postalCode ? { postalCode: campus.postalCode } : {}),
          addressCountry: "US",
        },
      }
    : {}),
  ...(campus.location
    ? { geo: { "@type": "GeoCoordinates", latitude: campus.location.lat, longitude: campus.location.lng } }
    : {}),
  ...(campus.hours
    ? {
        openingHoursSpecification: {
          "@type": "OpeningHoursSpecification",
          dayOfWeek: ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday"],
          opens: "07:00",
          closes: "18:00",
        },
      }
    : {}),
  ...(hos?.name ? { employee: { "@type": "Person", name: hos.name, jobTitle: hos.title ?? "Head of School" } } : {}),
  parentOrganization: { "@type": "EducationalOrganization", name: "Illuminate Montessori" },
};

const mapsHref = campus.address
  ? `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(
      [campus.address, campus.city, stateLabel, campus.postalCode].filter(Boolean).join(", ")
    )}`
  : null;
---

<Layout
  title={campus.name}
  metaTitle={`Montessori Preschool in ${cityState} | Illuminate Montessori ${campus.name}`}
  description={description}
  ogImage={campus.heroImageUrl ?? hos?.photoUrl ?? "/images/core/home-hero.jpeg"}
  schema={[schema, breadcrumb]}
>
  <!-- Hero -->
  <section class="bg-cream">
    <div class="mx-auto max-w-6xl px-6 lg:px-8 pt-14 pb-14 grid gap-10 lg:grid-cols-2 items-center">
      <div>
        <p class="text-xs font-semibold tracking-[0.2em] text-teal-500 uppercase">{cityState}</p>
        <h1 class="mt-4 font-serif text-4xl sm:text-5xl text-ink leading-tight">
          Illuminate Montessori
          <br />
          at {campus.name}
        </h1>

        {campus.agesServed && (
          <p class="mt-4 text-slate">Serving ages <strong class="text-ink font-medium">{campus.agesServed}</strong></p>
        )}

        {programs.length > 0 && (
          <ul class="mt-5 flex flex-wrap gap-2">
            {programs.map((p) => (
              <li class="rounded-full bg-white border border-teal-100 px-3.5 py-1.5 text-xs font-medium text-teal-600">
                {p.name}{p.ages || p.defaultAges ? <span class="text-slate font-normal"> · {p.ages || p.defaultAges}</span> : null}
              </li>
            ))}
          </ul>
        )}

        <a href="#tour" class="mt-7 inline-flex items-center rounded-full bg-teal-400 px-7 py-3 text-sm font-medium text-white hover:bg-teal-500 transition-colors">
          Schedule a Tour
        </a>
      </div>

      {campus.heroImageUrl ? (
        <img src={campus.heroImageUrl} alt={`Illuminate Montessori at ${campus.name}`} width="1000" height="384" class="rounded-2xl w-full h-96 object-cover" />
      ) : hos?.photoUrl ? (
        <div class="rounded-2xl overflow-hidden bg-teal-light">
          <img src={hos.photoUrl} alt={hos.name} width="500" height="384" class="w-full h-96 object-cover object-top" />
        </div>
      ) : (
        <div class="rounded-2xl w-full h-96 bg-teal-light flex items-center justify-center">
          <img src="/images/core/logo-illuminate.png" alt="" width="80" height="80" class="h-20 w-auto opacity-60" />
        </div>
      )}
    </div>
  </section>

  <!-- Contact strip -->
  <section class="border-b border-black/5">
    <dl class="mx-auto max-w-6xl px-6 lg:px-8 py-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
      {campus.address && (
        <div>
          <dt class="text-xs font-semibold tracking-wider text-ink uppercase">Visit</dt>
          <dd class="mt-1 text-sm text-slate">
            <a href={mapsHref} target="_blank" rel="noopener noreferrer" class="hover:text-teal-500">
              {campus.address}{campus.city ? `, ${campus.city}, ${stateLabel}` : ""}
            </a>
          </dd>
        </div>
      )}
      {campus.phone && (
        <div>
          <dt class="text-xs font-semibold tracking-wider text-ink uppercase">Call</dt>
          <dd class="mt-1 text-sm text-slate"><a href={`tel:${campus.phone.replace(/[^0-9+]/g, "")}`} class="hover:text-teal-500">{campus.phone}</a></dd>
        </div>
      )}
      {campus.email && (
        <div>
          <dt class="text-xs font-semibold tracking-wider text-ink uppercase">Email</dt>
          <dd class="mt-1 text-sm text-slate break-all"><a href={`mailto:${campus.email.trim()}`} class="hover:text-teal-500">{campus.email.trim()}</a></dd>
        </div>
      )}
      {campus.hours && (
        <div>
          <dt class="text-xs font-semibold tracking-wider text-ink uppercase">Hours</dt>
          <dd class="mt-1 text-sm text-slate">{campus.hours}</dd>
        </div>
      )}
    </dl>
  </section>

  <!-- Head of School — the most campus-specific thing on the page, so it leads -->
  {hos?.name && (
    <section class="mx-auto max-w-5xl px-6 lg:px-8 py-16">
      <p class="text-xs font-semibold tracking-[0.2em] text-teal-500 uppercase">{hos.title ?? "Head of School"}</p>
      <div class="mt-6 grid gap-8 sm:grid-cols-[200px_1fr] items-start">
        {hos.photoUrl ? (
          <img src={hos.photoUrl} alt={hos.name} width="200" height="200" class="rounded-2xl w-full sm:w-[200px] h-[200px] object-cover object-top" />
        ) : (
          <div class="rounded-2xl w-full sm:w-[200px] h-[200px] bg-teal-light flex items-center justify-center">
            <span class="font-serif text-4xl text-teal-300">{hos.name.charAt(0)}</span>
          </div>
        )}
        <div>
          <h2 class="font-serif text-2xl text-ink">{hos.name}</h2>
          {hos.bio && (
            <div class="mt-3 space-y-3">
              {hos.bio.split("\n\n").filter(Boolean).map((p: string) => (
                <p class="text-sm leading-relaxed text-slate">{p}</p>
              ))}
            </div>
          )}
        </div>
      </div>
    </section>
  )}

  <!-- About this campus -->
  {campus.about && (
    <section class="bg-cream">
      <div class="mx-auto max-w-3xl px-6 lg:px-8 py-16">
        <h2 class="font-serif text-2xl text-ink mb-4">About This Campus</h2>
        {campus.about.split("\n\n").filter(Boolean).map((p: string) => (
          <p class="text-slate leading-relaxed mb-4">{p}</p>
        ))}
      </div>
    </section>
  )}

  <!-- Programs at this campus -->
  {programs.length > 0 && (
    <section class="mx-auto max-w-6xl px-6 lg:px-8 py-16">
      <h2 class="font-serif text-2xl text-ink">Programs at {campus.name}</h2>
      {campus.agesServed && <p class="mt-2 text-sm text-slate">Current ages served: {campus.agesServed}</p>}
      <div class="mt-8 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
        {programs.map((p) => (
          <div class="rounded-2xl border border-black/5 p-5">
            <h3 class="font-serif text-lg text-ink">{p.name}</h3>
            {(p.ages || p.defaultAges) && <p class="mt-1 text-xs font-medium text-teal-500">{p.ages || p.defaultAges}</p>}
            {p.description && <p class="mt-2 text-sm leading-relaxed text-slate">{p.description}</p>}
          </div>
        ))}
      </div>

      {campus.schoolAgeCare && (
        <div class="mt-6 rounded-2xl bg-teal-light p-5">
          <h3 class="font-medium text-ink">School-Age Care (SAAC)</h3>
          <p class="mt-1 text-sm text-slate leading-relaxed">
            {campus.schoolAgeCareNote ??
              "Serving elementary students ages 5–12 with flexible care options, including before & after school care and drop-in care on select school holidays and closures when our campus remains open."}
          </p>
        </div>
      )}

      <p class="mt-8 text-sm text-slate">
        Every campus follows the same Montessori curriculum —
        <a href="/what-is-montessori/" class="text-teal-500 font-medium hover:text-teal-600"> see how it works</a>.
      </p>
    </section>
  )}

  <!-- Tour -->
  <section id="tour" class="bg-cream scroll-mt-20">
    <div class="mx-auto max-w-2xl px-6 lg:px-8 py-16 text-center">
      <h2 class="font-serif text-2xl text-ink">Schedule Your Visit to {campus.name}</h2>
      <p class="mt-3 text-slate">See our prepared environment for yourself. We host weekday tours by appointment.</p>
      {campus.bookingIframeUrl ? (
        <div class="mt-8 rounded-2xl overflow-hidden bg-teal-500">
          <iframe src={campus.bookingIframeUrl} class="w-full" style="height: 680px; border: none; display: block;" title={`Schedule a tour at ${campus.name}`} loading="lazy" />
        </div>
      ) : (
        <a href="/contact/" class="mt-8 inline-flex items-center rounded-full bg-teal-400 px-7 py-3 text-sm font-medium text-white hover:bg-teal-500 transition-colors">Schedule a Tour</a>
      )}
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-6 lg:px-8 py-12 text-center">
    <a href="/our-schools/" class="inline-flex items-center rounded-full border border-black/10 px-7 py-3 text-sm font-medium text-ink hover:border-teal-300 transition-colors">
      Explore other campuses
    </a>
  </section>
</Layout>
