---
export const prerender = false;

import Layout from "../layouts/Layout.astro";
import { getCampusBySlug } from "../lib/campuses";

const { campus: slug } = Astro.params;
const campus = slug ? await getCampusBySlug(slug) : null;

if (!campus) {
  return Astro.redirect("/our-schools/", 307);
}

const stateAbbr: Record<string, string> = { Virginia: "VA", Massachusetts: "MA", Texas: "TX" };
const stateLabel = stateAbbr[campus.region] ?? campus.region;
---

<Layout title={campus.name} description={`Illuminate Montessori at ${campus.name} — tour info, hours, and contact details.`}>
  <section class="bg-cream">
    <div class="mx-auto max-w-6xl px-6 lg:px-8 pt-16 pb-16 grid gap-10 lg:grid-cols-2 items-center">
      <div>
        <p class="text-xs font-semibold tracking-[0.2em] text-teal-500 uppercase">{campus.name}, {stateLabel}</p>
        <h1 class="mt-4 font-serif text-4xl sm:text-5xl text-ink leading-tight">
          Illuminate Montessori
          <br />
          at {campus.name}
        </h1>
        <a href="#tour" class="mt-6 inline-flex items-center rounded-full bg-teal-400 px-7 py-3 text-sm font-medium text-white hover:bg-teal-500 transition-colors">
          Schedule a Tour
        </a>

        <dl class="mt-10 grid gap-5 sm:grid-cols-2">
          {campus.address && (
            <div>
              <dt class="text-xs font-semibold tracking-wider text-ink uppercase">Visit</dt>
              <dd class="mt-1 text-sm text-slate">{campus.address}</dd>
            </div>
          )}
          {campus.phone && (
            <div>
              <dt class="text-xs font-semibold tracking-wider text-ink uppercase">Call</dt>
              <dd class="mt-1 text-sm text-slate"><a href={`tel:${campus.phone}`} class="hover:text-teal-500">{campus.phone}</a></dd>
            </div>
          )}
          {campus.email && (
            <div>
              <dt class="text-xs font-semibold tracking-wider text-ink uppercase">Email</dt>
              <dd class="mt-1 text-sm text-slate break-all"><a href={`mailto:${campus.email}`} class="hover:text-teal-500">{campus.email}</a></dd>
            </div>
          )}
          {campus.hours && (
            <div>
              <dt class="text-xs font-semibold tracking-wider text-ink uppercase">Operating Hours</dt>
              <dd class="mt-1 text-sm text-slate">{campus.hours}</dd>
            </div>
          )}
        </dl>
      </div>

      {campus.heroImageUrl ? (
        <img src={campus.heroImageUrl} alt={`Illuminate Montessori at ${campus.name}`} class="rounded-2xl w-full h-96 object-cover" />
      ) : (
        <div class="rounded-2xl w-full h-96 bg-teal-light flex items-center justify-center">
          <svg class="w-16 h-16 text-teal-300" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
            <path d="M12 2v6M9 22h6M8 22c-1-3 0-5 1-6.5C10.3 13.8 11 12.5 11 10.5V8h2v2.5c0 2 .7 3.3 2 4.5 1 1.5 2 3.5 1 7" />
          </svg>
        </div>
      )}
    </div>
  </section>

  {campus.about && (
    <section class="mx-auto max-w-3xl px-6 lg:px-8 py-16">
      <h2 class="font-serif text-2xl text-ink mb-4">About This Campus</h2>
      {campus.about.split("\n\n").filter(Boolean).map((p: string) => (
        <p class="text-slate leading-relaxed mb-4">{p}</p>
      ))}
    </section>
  )}

  <section id="tour" class="bg-cream scroll-mt-20">
    <div class="mx-auto max-w-2xl px-6 lg:px-8 py-16 text-center">
      <h2 class="font-serif text-2xl text-ink">Schedule Your Visit to {campus.name}</h2>
      <p class="mt-3 text-slate">See our prepared environment for yourself. We host weekday tours by appointment.</p>
      {campus.bookingIframeUrl ? (
        <div class="mt-8 rounded-2xl overflow-hidden bg-teal-500">
          <iframe src={campus.bookingIframeUrl} class="w-full" style="height: 680px; border: none; display: block;" title={`Schedule a tour at ${campus.name}`} />
        </div>
      ) : (
        <a href="/contact/" class="mt-8 inline-flex items-center rounded-full bg-teal-400 px-7 py-3 text-sm font-medium text-white hover:bg-teal-500 transition-colors">
          Schedule a Tour
        </a>
      )}
    </div>
  </section>
</Layout>
