---
import "../styles/global.css";

interface Props {
  title: string;
  description?: string;
}

const { title, description = "Montessori education for the whole child." } = Astro.props;

const navLinks = [
  { label: "Find Your Campus", href: "/campuses/" },
  { label: "What is Montessori?", href: "/montessori/" },
  { label: "Admissions", href: "/admissions/" },
  { label: "Tuition", href: "/" },
  { label: "About", href: "/about/" },
];
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <title>{title} · Illuminate Montessori</title>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;1,400&family=Inter:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="bg-white text-slate">
    <header class="border-b border-black/5">
      <div class="mx-auto max-w-7xl px-6 lg:px-8 h-20 flex items-center justify-between">
        <a href="/" class="flex items-center gap-2 font-serif text-xl text-ink">
          <svg class="w-7 h-7 text-teal-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
            <path d="M12 2v6M9 22h6M8 22c-1-3 0-5 1-6.5C10.3 13.8 11 12.5 11 10.5V8h2v2.5c0 2 .7 3.3 2 4.5 1 1.5 2 3.5 1 7" />
          </svg>
          Illuminate
        </a>

        <nav class="hidden lg:flex items-center gap-8 text-sm font-medium text-ink/80">
          {navLinks.map((link) => (
            <a href={link.href} class="hover:text-teal-500 transition-colors">{link.label}</a>
          ))}
        </nav>

        <a
          href="/contact/"
          class="hidden sm:inline-flex items-center rounded-full bg-teal-400 px-5 py-2.5 text-sm font-medium text-white hover:bg-teal-500 transition-colors"
        >
          Schedule a Tour
        </a>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="border-t border-black/5 bg-cream">
      <div class="mx-auto max-w-7xl px-6 lg:px-8 py-12 text-sm text-slate flex flex-col sm:flex-row items-center justify-between gap-4">
        <p>&copy; {new Date().getFullYear()} Illuminate Montessori. All rights reserved.</p>
        <div class="flex gap-6">
          <a href="/contact/" class="hover:text-teal-500">Contact</a>
          <a href="/campuses/" class="hover:text-teal-500">Campuses</a>
        </div>
      </div>
    </footer>
  </body>
</html>
