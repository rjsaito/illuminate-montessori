---
import "../styles/global.css";
import { getAllCampuses } from "../lib/campuses";
import { sanityClient } from "../lib/sanity";
import { ALL_PROGRAMS_QUERY } from "../lib/queries";

interface Props {
  title: string;
  /** Full <title> override. Otherwise "{title} | Illuminate Montessori". */
  metaTitle?: string;
  description?: string;
  ogImage?: string;
  /** Extra JSON-LD to emit alongside the sitewide Organization schema. */
  schema?: Record<string, any> | Record<string, any>[];
}

const {
  title,
  metaTitle,
  description = "Authentic Montessori education for children from 6 weeks through 12 years, across 18 campuses in Virginia, Massachusetts, and Texas.",
  ogImage = "/images/core/home-hero.jpeg",
  schema,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogImageUrl = new URL(ogImage, Astro.site).href;
const fullTitle = metaTitle ?? `${title} | Illuminate Montessori`;

const campuses = await getAllCampuses();
const findCampuses = campuses.filter((c) => c.showOnFindCampus !== false && c.region !== "Texas");
const texasCampuses = campuses.filter((c) => c.region === "Texas");
const socialCampuses = campuses.filter((c) => c.instagram);

const allPrograms = sanityClient ? ((await sanityClient.fetch(ALL_PROGRAMS_QUERY)) ?? []) : [];
const offeredSlugs = new Set(campuses.flatMap((c) => (c.programs ?? []).map((p: any) => p.slug)));
const navPrograms = allPrograms.filter((p: any) => offeredSlugs.has(p.slug));

const navLinks = [
  { label: "What is Montessori?", href: "/what-is-montessori/" },
  { label: "Admissions", href: "/admissions/" },
  { label: "Tuition", href: "/tuition/" },
  { label: "About", href: "/about/" },
  { label: "Contact", href: "/contact/" },
];

const organizationSchema = {
  "@context": "https://schema.org",
  "@type": "EducationalOrganization",
  name: "Illuminate Montessori",
  url: Astro.site?.href,
  logo: new URL("/images/core/logo-illuminate.png", Astro.site).href,
  email: "hello@illuminatemontessori.com",
  description,
  areaServed: ["Virginia", "Massachusetts", "Texas"],
};

const schemaBlocks = [organizationSchema, ...(schema ? (Array.isArray(schema) ? schema : [schema]) : [])];
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/png" href="/images/core/logo-mark.png" />
    <link rel="apple-touch-icon" href="/images/core/logo-mark.png" />
    <link rel="canonical" href={canonical} />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Illuminate Montessori" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageUrl} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;1,400&family=Playfair+Display:wght@500;600&family=Inter:wght@400;500;600&display=swap"
      rel="stylesheet"
    />

    {schemaBlocks.map((block) => (
      <script type="application/ld+json" set:html={JSON.stringify(block)} />
    ))}
  </head>
  <body class="bg-white text-slate">
    <a href="#main" class="sr-only focus:not-sr-only focus:absolute focus:top-2 focus:left-2 focus:z-50 focus:rounded focus:bg-white focus:px-4 focus:py-2 focus:text-ink">
      Skip to content
    </a>

    <header class="border-b border-black/5 relative z-50 bg-white">
      <div class="mx-auto max-w-7xl px-6 lg:px-8 h-20 flex items-center justify-between">
        <a href="/" class="flex items-center gap-2.5" aria-label="Illuminate Montessori — home">
          <img src="/images/core/logo-mark.png" alt="" width="181" height="246" class="h-11 w-auto" />
          <span class="font-wordmark text-[1.6rem] leading-none text-ink">Illuminate</span>
        </a>

        <nav aria-label="Main" class="hidden xl:flex items-center gap-6 text-sm font-medium text-ink/80">
          {/* Campuses and Programs share one pattern: the label is a link to the
              overview page, the chevron is a separate control that opens the list. */}
          <div class="relative flex items-center gap-1" data-dropdown>
            <a href="/our-schools/" class="hover:text-teal-500 transition-colors">Campuses</a>
            <button
              type="button"
              class="p-1 -m-1 hover:text-teal-500 transition-colors"
              aria-expanded="false"
              aria-haspopup="true"
              aria-label="Open campus list"
              data-dropdown-trigger
            >
              <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M6 9l6 6 6-6" /></svg>
            </button>
            <div
              class="hidden absolute left-0 top-full w-56 rounded-xl border border-black/5 bg-white py-2 shadow-lg"
              data-dropdown-menu
            >
              {findCampuses.map((c) => (
                <a href={`/${c.slug}/`} class="block px-4 py-2 text-sm hover:bg-teal-light hover:text-teal-600">{c.name}</a>
              ))}
              <div class="my-1 border-t border-black/5"></div>
              <a href="/our-schools/" class="block px-4 py-2 text-sm font-medium text-teal-500 hover:bg-teal-light">See all campuses</a>
            </div>
          </div>

          {navPrograms.length > 0 && (
            <div class="relative flex items-center gap-1" data-dropdown>
              <a href="/programs/" class="hover:text-teal-500 transition-colors">Programs</a>
              <button
                type="button"
                class="p-1 -m-1 hover:text-teal-500 transition-colors"
                aria-expanded="false"
                aria-haspopup="true"
                aria-label="Open program list"
                data-dropdown-trigger
              >
                <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M6 9l6 6 6-6" /></svg>
              </button>
              <div
                class="hidden absolute left-0 top-full w-60 rounded-xl border border-black/5 bg-white py-2 shadow-lg"
                data-dropdown-menu
              >
                {navPrograms.map((p: any) => (
                  <a href={`/programs/${p.slug}/`} class="block px-4 py-2 text-sm hover:bg-teal-light hover:text-teal-600">{p.name}</a>
                ))}
                <div class="my-1 border-t border-black/5"></div>
                <a href="/programs/" class="block px-4 py-2 text-sm font-medium text-teal-500 hover:bg-teal-light">All programs</a>
              </div>
            </div>
          )}

          {navLinks.map((link) => (
            <a href={link.href} class="hover:text-teal-500 transition-colors">{link.label}</a>
          ))}

          {texasCampuses.length > 0 && (
            <div class="relative" data-dropdown>
              <button
                type="button"
                class="flex items-center gap-1 hover:text-teal-500 transition-colors"
                aria-expanded="false"
                aria-haspopup="true"
                data-dropdown-trigger
              >
                Texas Schools
                <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M6 9l6 6 6-6" /></svg>
              </button>
              <div
                class="hidden absolute right-0 top-full w-56 rounded-xl border border-black/5 bg-white py-2 shadow-lg"
                data-dropdown-menu
              >
                {texasCampuses.map((c) => (
                  <a href={`/${c.slug}/`} class="block px-4 py-2 text-sm hover:bg-teal-light hover:text-teal-600">{c.name}</a>
                ))}
              </div>
            </div>
          )}
        </nav>

        <div class="flex items-center gap-3">
          {/* Tours are booked per campus (every campus page has a live booking
              widget), so this starts at the finder rather than the contact form. */}
          <a
            href="/our-schools/"
            class="hidden sm:inline-flex items-center rounded-full bg-teal-400 px-5 py-2.5 text-sm font-medium text-white hover:bg-teal-500 transition-colors"
          >
            Schedule a Tour
          </a>

          <button
            type="button"
            class="xl:hidden inline-flex items-center justify-center rounded-lg p-2 text-ink hover:bg-cream"
            aria-expanded="false"
            aria-controls="mobile-menu"
            aria-label="Open menu"
            data-mobile-trigger
          >
            <svg class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
              <path d="M4 6h16M4 12h16M4 18h16" />
            </svg>
          </button>
        </div>
      </div>

      <!-- Mobile menu -->
      <div id="mobile-menu" class="hidden xl:hidden border-t border-black/5 bg-white" data-mobile-menu>
        <nav aria-label="Mobile" class="mx-auto max-w-7xl px-6 py-4 space-y-1">
          {navLinks.map((link) => (
            <a href={link.href} class="block rounded-lg px-3 py-2.5 text-sm font-medium text-ink hover:bg-cream">{link.label}</a>
          ))}
          <a href="/our-schools/" class="block rounded-lg px-3 py-2.5 text-sm font-medium text-ink hover:bg-cream">Campuses</a>

          {navPrograms.length > 0 && (
            <details class="rounded-lg">
              <summary class="cursor-pointer list-none rounded-lg px-3 py-2.5 text-sm font-medium text-ink hover:bg-cream">Programs</summary>
              <div class="pl-3 pb-2">
                {navPrograms.map((p: any) => (
                  <a href={`/programs/${p.slug}/`} class="block rounded-lg px-3 py-2 text-sm text-slate hover:bg-cream">{p.name}</a>
                ))}
                <a href="/programs/" class="block rounded-lg px-3 py-2 text-sm font-medium text-teal-500 hover:bg-cream">All programs</a>
              </div>
            </details>
          )}

          <details class="rounded-lg">
            <summary class="cursor-pointer list-none rounded-lg px-3 py-2.5 text-sm font-medium text-ink hover:bg-cream">Jump to a campus</summary>
            <div class="pl-3 pb-2">
              {findCampuses.map((c) => (
                <a href={`/${c.slug}/`} class="block rounded-lg px-3 py-2 text-sm text-slate hover:bg-cream">{c.name}</a>
              ))}
            </div>
          </details>

          {texasCampuses.length > 0 && (
            <details class="rounded-lg">
              <summary class="cursor-pointer list-none rounded-lg px-3 py-2.5 text-sm font-medium text-ink hover:bg-cream">Texas Schools</summary>
              <div class="pl-3 pb-2">
                {texasCampuses.map((c) => (
                  <a href={`/${c.slug}/`} class="block rounded-lg px-3 py-2 text-sm text-slate hover:bg-cream">{c.name}</a>
                ))}
              </div>
            </details>
          )}

          <a href="/our-schools/" class="mt-2 block rounded-full bg-teal-400 px-5 py-3 text-center text-sm font-medium text-white hover:bg-teal-500">
            Schedule a Tour
          </a>
        </nav>
      </div>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="border-t border-black/5 bg-cream">
      {/* Columns mirror the top nav so the two never drift: Campuses, Programs,
          the standalone pages, and Texas Schools kept separate as in the header. */}
      <div class="mx-auto max-w-7xl px-6 lg:px-8 py-14 grid gap-10 sm:grid-cols-2 lg:grid-cols-4">
        <div>
          <a href="/" class="flex items-center gap-2.5">
            <img src="/images/core/logo-mark.png" alt="" width="181" height="246" class="h-9 w-auto" />
            <span class="font-wordmark text-xl leading-none text-ink">Illuminate</span>
          </a>
          <p class="mt-3 text-sm text-slate">A place families trust, and children love.</p>
        </div>
        <div>
          <p class="text-xs font-semibold tracking-wider text-ink uppercase">Campuses</p>
          <ul class="mt-3 space-y-2 text-sm">
            <li><a href="/our-schools/" class="hover:text-teal-500">All campuses</a></li>
            <li><a href="/programs/" class="hover:text-teal-500">Programs</a></li>
            <li><a href="/contact/" class="hover:text-teal-500">Schedule a Tour</a></li>
          </ul>
          {texasCampuses.length > 0 && (
            <>
              <p class="mt-5 text-xs font-semibold tracking-wider text-ink uppercase">Texas Schools</p>
              <ul class="mt-3 space-y-2 text-sm">
                {texasCampuses.map((c) => (
                  <li><a href={`/${c.slug}/`} class="hover:text-teal-500">{c.name}</a></li>
                ))}
              </ul>
            </>
          )}
        </div>
        <div>
          <p class="text-xs font-semibold tracking-wider text-ink uppercase">Explore</p>
          <ul class="mt-3 space-y-2 text-sm">
            <li><a href="/what-is-montessori/" class="hover:text-teal-500">What is Montessori?</a></li>
            <li><a href="/admissions/" class="hover:text-teal-500">Admissions</a></li>
            <li><a href="/tuition/" class="hover:text-teal-500">Tuition</a></li>
            <li><a href="/about/" class="hover:text-teal-500">About</a></li>
          </ul>
        </div>
        <div>
          <p class="text-xs font-semibold tracking-wider text-ink uppercase">Contact</p>
          <ul class="mt-3 space-y-2 text-sm">
            <li><a href="mailto:hello@illuminatemontessori.com" class="hover:text-teal-500">hello@illuminatemontessori.com</a></li>
          </ul>
          {socialCampuses.length > 0 && (
            <>
              <p class="mt-5 text-xs font-semibold tracking-wider text-ink uppercase">Follow a campus</p>
              <ul class="mt-3 space-y-1.5 text-sm">
                {socialCampuses.map((c) => (
                  <li>
                    <a href={`https://instagram.com/${c.instagram.replace(/^@/, "")}`} target="_blank" rel="noopener noreferrer" class="hover:text-teal-500">
                      {c.name} on Instagram
                    </a>
                  </li>
                ))}
              </ul>
            </>
          )}
        </div>
      </div>
      <div class="border-t border-black/5">
        <div class="mx-auto max-w-7xl px-6 lg:px-8 py-6 text-xs text-slate flex flex-col sm:flex-row items-center justify-between gap-4">
          <p>&copy; {new Date().getFullYear()} Illuminate Montessori. All rights reserved.</p>
        </div>
      </div>
    </footer>

    <script>
      // Desktop dropdowns: click/keyboard to toggle, hover to open, Esc to close.
      const dropdowns = document.querySelectorAll<HTMLElement>("[data-dropdown]");
      dropdowns.forEach((wrapper) => {
        const trigger = wrapper.querySelector<HTMLButtonElement>("[data-dropdown-trigger]");
        const menu = wrapper.querySelector<HTMLElement>("[data-dropdown-menu]");
        if (!trigger || !menu) return;

        const open = () => {
          menu.classList.remove("hidden");
          trigger.setAttribute("aria-expanded", "true");
        };
        const close = () => {
          menu.classList.add("hidden");
          trigger.setAttribute("aria-expanded", "false");
        };

        trigger.addEventListener("click", () => {
          menu.classList.contains("hidden") ? open() : close();
        });
        wrapper.addEventListener("mouseenter", open);
        wrapper.addEventListener("mouseleave", close);
        wrapper.addEventListener("focusout", (e) => {
          if (!wrapper.contains(e.relatedTarget as Node)) close();
        });
        wrapper.addEventListener("keydown", (e) => {
          if ((e as KeyboardEvent).key === "Escape") {
            close();
            trigger.focus();
          }
        });
      });

      // Mobile menu toggle
      const mobileTrigger = document.querySelector<HTMLButtonElement>("[data-mobile-trigger]");
      const mobileMenu = document.querySelector<HTMLElement>("[data-mobile-menu]");
      mobileTrigger?.addEventListener("click", () => {
        const isHidden = mobileMenu?.classList.toggle("hidden");
        mobileTrigger.setAttribute("aria-expanded", String(!isHidden));
        mobileTrigger.setAttribute("aria-label", isHidden ? "Open menu" : "Close menu");
      });
    </script>
  </body>
</html>
