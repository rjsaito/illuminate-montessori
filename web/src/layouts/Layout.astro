---
import "../styles/global.css";
import { getAllCampuses } from "../lib/campuses";

interface Props {
  title: string;
  description?: string;
}

const { title, description = "Montessori education for the whole child." } = Astro.props;

const campuses = await getAllCampuses();
const findCampuses = campuses.filter((c) => c.showOnFindCampus !== false && c.region !== "Texas");
const texasCampuses = campuses.filter((c) => c.region === "Texas");

const navLinks = [
  { label: "What is Montessori?", href: "/what-is-montessori/" },
  { label: "Admissions", href: "/admissions/" },
  { label: "Tuition", href: "/tuition/" },
  { label: "About", href: "/about/" },
];
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <title>{title} · Illuminate Montessori</title>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;1,400&family=Inter:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="bg-white text-slate">
    <header class="border-b border-black/5 relative z-50">
      <div class="mx-auto max-w-7xl px-6 lg:px-8 h-20 flex items-center justify-between">
        <a href="/" class="flex items-center gap-2 font-serif text-xl text-ink">
          <svg class="w-7 h-7 text-teal-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
            <path d="M12 2v6M9 22h6M8 22c-1-3 0-5 1-6.5C10.3 13.8 11 12.5 11 10.5V8h2v2.5c0 2 .7 3.3 2 4.5 1 1.5 2 3.5 1 7" />
          </svg>
          Illuminate
        </a>

        <nav class="hidden lg:flex items-center gap-8 text-sm font-medium text-ink/80">
          <div class="group relative">
            <button class="flex items-center gap-1 hover:text-teal-500 transition-colors">
              Find Your Campus
              <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 9l6 6 6-6" /></svg>
            </button>
            <div class="invisible absolute left-0 top-full w-56 rounded-xl border border-black/5 bg-white py-2 opacity-0 shadow-lg transition-all group-hover:visible group-hover:opacity-100">
              {findCampuses.map((c) => (
                <a href={`/${c.slug}/`} class="block px-4 py-2 text-sm hover:bg-teal-light hover:text-teal-600">{c.name}</a>
              ))}
              <div class="my-1 border-t border-black/5"></div>
              <a href="/our-schools/" class="block px-4 py-2 text-sm font-medium text-teal-500 hover:bg-teal-light">See All Campuses</a>
            </div>
          </div>

          {navLinks.map((link) => (
            <a href={link.href} class="hover:text-teal-500 transition-colors">{link.label}</a>
          ))}

          {texasCampuses.length > 0 && (
            <div class="group relative">
              <button class="flex items-center gap-1 hover:text-teal-500 transition-colors">
                Texas Schools
                <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 9l6 6 6-6" /></svg>
              </button>
              <div class="invisible absolute right-0 top-full w-56 rounded-xl border border-black/5 bg-white py-2 opacity-0 shadow-lg transition-all group-hover:visible group-hover:opacity-100">
                {texasCampuses.map((c) => (
                  <a href={`/${c.slug}/`} class="block px-4 py-2 text-sm hover:bg-teal-light hover:text-teal-600">{c.name}</a>
                ))}
              </div>
            </div>
          )}
        </nav>

        <a
          href="/contact/"
          class="hidden sm:inline-flex items-center rounded-full bg-teal-400 px-5 py-2.5 text-sm font-medium text-white hover:bg-teal-500 transition-colors"
        >
          Schedule a Tour
        </a>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="border-t border-black/5 bg-cream">
      <div class="mx-auto max-w-7xl px-6 lg:px-8 py-14 grid gap-10 sm:grid-cols-2 lg:grid-cols-4">
        <div>
          <a href="/" class="flex items-center gap-2 font-serif text-lg text-ink">Illuminate Montessori</a>
          <p class="mt-3 text-sm text-slate">A place families trust, and children love.</p>
        </div>
        <div>
          <p class="text-xs font-semibold tracking-wider text-ink uppercase">Explore</p>
          <ul class="mt-3 space-y-2 text-sm">
            <li><a href="/what-is-montessori/" class="hover:text-teal-500">What is Montessori?</a></li>
            <li><a href="/admissions/" class="hover:text-teal-500">Admissions</a></li>
            <li><a href="/tuition/" class="hover:text-teal-500">Tuition</a></li>
            <li><a href="/about/" class="hover:text-teal-500">About</a></li>
          </ul>
        </div>
        <div>
          <p class="text-xs font-semibold tracking-wider text-ink uppercase">Campuses</p>
          <ul class="mt-3 space-y-2 text-sm">
            <li><a href="/our-schools/" class="hover:text-teal-500">Find Your Campus</a></li>
            <li><a href="/contact/" class="hover:text-teal-500">Schedule a Tour</a></li>
          </ul>
        </div>
        <div>
          <p class="text-xs font-semibold tracking-wider text-ink uppercase">Contact</p>
          <ul class="mt-3 space-y-2 text-sm">
            <li><a href="mailto:hello@illuminatemontessori.com" class="hover:text-teal-500">hello@illuminatemontessori.com</a></li>
          </ul>
        </div>
      </div>
      <div class="border-t border-black/5">
        <div class="mx-auto max-w-7xl px-6 lg:px-8 py-6 text-xs text-slate flex flex-col sm:flex-row items-center justify-between gap-4">
          <p>&copy; {new Date().getFullYear()} Illuminate Montessori. All rights reserved.</p>
        </div>
      </div>
    </footer>
  </body>
</html>
