---
interface Testimonial {
  quote: string;
  authorName: string;
  authorRole?: string;
  campus?: string;
}

interface Props {
  testimonials: Testimonial[];
  heading?: string;
  /** Optional "read more on Google" link for a specific campus. */
  reviewsUrl?: string | null;
  reviewsLabel?: string;
}

const {
  testimonials,
  heading = "What families say",
  reviewsUrl = null,
  reviewsLabel = "Read our Google reviews",
} = Astro.props;

// Nothing to show and nowhere to send people — render nothing at all.
if (!testimonials?.length && !reviewsUrl) return null;
---

<section class="bg-cream">
  <div class="mx-auto max-w-6xl px-6 lg:px-8 py-16">
    <h2 class="font-serif text-2xl sm:text-3xl text-ink text-center">{heading}</h2>

    {testimonials?.length > 0 && (
      <div class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {testimonials.map((t) => (
          <figure class="rounded-2xl bg-white border border-black/5 p-6 flex flex-col">
            <svg class="w-7 h-7 text-teal-200" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M9.5 6C6.5 6 4 8.5 4 11.5c0 2.8 2 5 4.7 5.4-.3 1.4-1.2 2.5-2.5 3.1l.7 1.5c2.9-1.2 4.9-3.9 4.9-7.4V11c0-2.8-1-5-3.3-5zm10 0c-3 0-5.5 2.5-5.5 5.5 0 2.8 2 5 4.7 5.4-.3 1.4-1.2 2.5-2.5 3.1l.7 1.5c2.9-1.2 4.9-3.9 4.9-7.4V11c0-2.8-1-5-2.3-5z" />
            </svg>
            <blockquote class="mt-3 flex-1 text-sm leading-relaxed text-slate">{t.quote}</blockquote>
            <figcaption class="mt-5 text-sm">
              <span class="font-medium text-ink">{t.authorName}</span>
              {(t.authorRole || t.campus) && (
                <span class="block text-xs text-slate mt-0.5">
                  {[t.authorRole, t.campus].filter(Boolean).join(" · ")}
                </span>
              )}
            </figcaption>
          </figure>
        ))}
      </div>
    )}

    {reviewsUrl && (
      <p class="mt-10 text-center">
        <a
          href={reviewsUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 rounded-full border border-black/10 bg-white px-6 py-3 text-sm font-medium text-ink hover:border-teal-300 transition-colors"
        >
          <svg class="w-4 h-4" viewBox="0 0 24 24" aria-hidden="true">
            <path fill="#4285F4" d="M22.5 12.2c0-.8-.1-1.6-.2-2.3H12v4.5h5.9a5 5 0 0 1-2.2 3.3v2.7h3.6c2.1-1.9 3.2-4.8 3.2-8.2z"/>
            <path fill="#34A853" d="M12 23c2.9 0 5.4-1 7.2-2.6l-3.6-2.7c-1 .7-2.3 1.1-3.7 1.1-2.8 0-5.2-1.9-6.1-4.5H2.2v2.8A11 11 0 0 0 12 23z"/>
            <path fill="#FBBC05" d="M5.9 14.3a6.6 6.6 0 0 1 0-4.2V7.3H2.2a11 11 0 0 0 0 9.8l3.7-2.8z"/>
            <path fill="#EA4335" d="M12 5.4c1.6 0 3 .5 4.1 1.6l3.1-3.1A11 11 0 0 0 2.2 7.3l3.7 2.8C6.8 7.3 9.2 5.4 12 5.4z"/>
          </svg>
          {reviewsLabel}
        </a>
      </p>
    )}
  </div>
</section>
