---
import type { CampusData } from "../lib/campuses";

interface Props {
  campuses: CampusData[];
  programs: { name: string; slug: string }[];
  /** Home-page variant: no filter chips, shorter map, nearest few results only. */
  compact?: boolean;
}

const { campuses, programs, compact = false } = Astro.props;

const stateAbbr: Record<string, string> = { Virginia: "VA", Massachusetts: "MA", Texas: "TX" };

// Everything the client-side filter needs, serialized once.
const payload = campuses.map((c) => ({
  slug: c.slug,
  name: c.name,
  region: c.region,
  state: stateAbbr[c.region] ?? c.region,
  city: c.city ?? "",
  address: c.address ?? "",
  phone: c.phone ?? "",
  agesServed: c.agesServed ?? "",
  lat: c.location?.lat ?? null,
  lng: c.location?.lng ?? null,
  programs: (c.programs ?? []).map((p) => p.slug),
  programNames: (c.programs ?? []).map((p) => p.name),
}));
---

<div data-campus-finder>
  <!-- Controls -->
  <div class="rounded-2xl border border-black/5 bg-white p-5 sm:p-6">
    <div class={compact ? "" : "grid gap-5 lg:grid-cols-[1fr_auto]"}>
      <div class={compact ? "hidden" : ""}>
        <label class="text-xs font-semibold tracking-wider text-ink uppercase" for="program-filter">Program</label>
        <div class="mt-2.5 flex flex-wrap gap-2" id="program-filter" role="group" aria-label="Filter by program">
          <button type="button" data-program="" aria-pressed="true"
            class="rounded-full border min-h-11 sm:min-h-0 px-4 py-2.5 sm:py-1.5 text-sm sm:text-xs font-medium transition-colors border-teal-400 bg-teal-400 text-white">
            All programs
          </button>
          {programs.map((p) => (
            <button type="button" data-program={p.slug} aria-pressed="false"
              class="rounded-full border border-black/10 min-h-11 sm:min-h-0 px-4 py-2.5 sm:py-1.5 text-sm sm:text-xs font-medium text-ink hover:border-teal-300 transition-colors">
              {p.name}
            </button>
          ))}
        </div>

        <div class="mt-5 flex flex-wrap gap-2" id="state-filter" role="group" aria-label="Filter by state">
          <button type="button" data-state="" aria-pressed="true"
            class="rounded-full border min-h-11 sm:min-h-0 px-4 py-2.5 sm:py-1.5 text-sm sm:text-xs font-medium transition-colors border-teal-400 bg-teal-400 text-white">
            All states
          </button>
          {["VA", "MA", "TX"].map((s) => (
            <button type="button" data-state={s} aria-pressed="false"
              class="rounded-full border border-black/10 min-h-11 sm:min-h-0 px-4 py-2.5 sm:py-1.5 text-sm sm:text-xs font-medium text-ink hover:border-teal-300 transition-colors">
              {s}
            </button>
          ))}
        </div>
      </div>

      <div class={compact ? "" : "lg:w-72"}>
        <label class="text-xs font-semibold tracking-wider text-ink uppercase" for="zip-input">{compact ? "Find a campus near you" : "Near you"}</label>
        <div class="mt-2.5 flex gap-2">
          <input id="zip-input" type="text" inputmode="numeric" placeholder="ZIP code"
            class="w-full rounded-lg border border-black/10 px-3 py-2.5 text-base sm:text-sm focus:border-teal-400 focus:outline-none" />
          <button type="button" id="zip-go"
            class="rounded-lg bg-teal-400 px-5 py-2.5 text-sm font-medium text-white hover:bg-teal-500 transition-colors">Go</button>
        </div>
        <div id="radius-wrap" class="mt-3 hidden">
          <label class="text-xs font-medium text-slate" for="radius-select">Within</label>
          <select id="radius-select"
            class="mt-1 w-full rounded-lg border border-black/10 px-3 py-2.5 text-base sm:text-sm focus:border-teal-400 focus:outline-none">
            <option value="0">Any distance</option>
            <option value="5">5 miles</option>
            <option value="10">10 miles</option>
            <option value="25" selected>25 miles</option>
            <option value="50">50 miles</option>
            <option value="100">100 miles</option>
          </select>
        </div>

        <button type="button" id="geo-btn"
          class="mt-2.5 inline-flex items-center gap-1.5 rounded-lg border border-black/10 px-4 py-2.5 text-sm font-medium text-ink hover:border-teal-300 hover:text-teal-600 transition-colors">
          <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path d="M12 21s7-5.6 7-11a7 7 0 1 0-14 0c0 5.4 7 11 7 11z" />
            <circle cx="12" cy="10" r="2.5" />
          </svg>
          Use my location
        </button>
        <p id="finder-status" class="mt-2 text-xs text-slate" role="status" aria-live="polite"></p>
      </div>
    </div>
  </div>

  <!-- Map -->
  <div id="campus-map" class:list={["mt-6 w-full rounded-2xl border border-black/5 bg-teal-light z-0", compact ? "h-[300px]" : "h-[420px]"]}></div>

  <!-- Results -->
  <p class="mt-6 text-sm text-slate" id="result-count"></p>
  <div class="mt-4 grid gap-4 sm:grid-cols-2 lg:grid-cols-3" id="campus-results"></div>
  <p id="no-results" class="mt-6 hidden rounded-2xl bg-cream p-6 text-center text-sm text-slate">
    No campuses match those filters. Try clearing the program filter or widening your search.
  </p>

  {compact && (
    <p class="mt-8 text-center">
      <a href="/our-schools/" class="inline-flex items-center rounded-full border border-black/10 px-7 py-3 text-sm font-medium text-ink hover:border-teal-300 transition-colors">
        See all {campuses.length} campuses &amp; filter by program
      </a>
    </p>
  )}
</div>

<script is:inline define:vars={{ payload, compact }}>
  window.__CAMPUSES__ = payload;
  window.__FINDER_COMPACT__ = compact;
</script>

<script>
  import "leaflet/dist/leaflet.css";

  // Real 5-digit ZIP centroids (GeoNames, public domain) for the states served and
  // their neighbours. Loaded on demand so it never weighs down the initial page.
  let ZIPS = null;
  async function loadZips() {
    if (!ZIPS) ZIPS = (await import("../lib/zipCentroids.json")).default;
    return ZIPS;
  }

  const $ = (s, r = document) => r.querySelector(s);
  const root = $("[data-campus-finder]");
  if (root) {
    const campuses = window.__CAMPUSES__ || [];
    const COMPACT = !!window.__FINDER_COMPACT__;
    const statusEl = $("#finder-status");
    const resultsEl = $("#campus-results");
    const countEl = $("#result-count");
    const noneEl = $("#no-results");

    let state = { program: "", stateCode: "", origin: null, radius: 25 };
    let map = null;
    let markers = {};

    const miles = (a, b) => {
      const R = 3958.8, toRad = (d) => (d * Math.PI) / 180;
      const dLat = toRad(b.lat - a.lat), dLng = toRad(b.lng - a.lng);
      const s = Math.sin(dLat / 2) ** 2 + Math.cos(toRad(a.lat)) * Math.cos(toRad(b.lat)) * Math.sin(dLng / 2) ** 2;
      return 2 * R * Math.asin(Math.sqrt(s));
    };

    function visible() {
      let list = campuses.filter(
        (c) =>
          (!state.program || c.programs.includes(state.program)) &&
          (!state.stateCode || c.state === state.stateCode)
      );
      if (state.origin) {
        list = list
          .map((c) => ({ ...c, dist: c.lat != null ? miles(state.origin, { lat: c.lat, lng: c.lng }) : Infinity }))
          .sort((a, b) => a.dist - b.dist);
        if (state.radius > 0) list = list.filter((c) => c.dist <= state.radius);
      }
      return list;
    }

    function render() {
      const all = visible();
      // Compact mode is a teaser: nothing listed until there's an origin, then the nearest 3.
      const list = COMPACT ? (state.origin ? all.slice(0, 3) : []) : all;
      resultsEl.innerHTML = list
        .map(
          (c) => `
        <a href="/${c.slug}/" class="group block rounded-2xl border border-black/5 bg-white p-6 hover:border-teal-300 hover:shadow-[0_8px_24px_rgb(0,0,0,0.06)] transition-all">
          <div class="flex items-baseline justify-between gap-3">
            <p class="font-serif text-xl text-ink">${c.name}</p>
            <span class="text-sm text-slate whitespace-nowrap">${
              c.dist != null && isFinite(c.dist) ? c.dist.toFixed(1) + " mi" : c.state
            }</span>
          </div>
          ${c.city ? `<p class="mt-1 text-sm text-slate">${c.city}, ${c.state}</p>` : ""}
          ${c.agesServed ? `<p class="mt-2 text-sm text-slate">Ages ${c.agesServed}</p>` : ""}
          <p class="mt-3 flex flex-wrap gap-1.5">${c.programNames
            .map((n) => `<span class="rounded-full bg-teal-light px-2.5 py-1 text-[13px] font-medium text-teal-600">${n}</span>`)
            .join("")}</p>
          <span class="mt-4 inline-block text-sm font-medium text-teal-500 group-hover:text-teal-600">Schedule a Tour →</span>
        </a>`
        )
        .join("");

      const radiusNote = state.origin && state.radius > 0 ? ` within ${state.radius} miles` : "";
      countEl.textContent = COMPACT
        ? (state.origin ? `Nearest ${list.length} of ${campuses.length} campuses` : "")
        : `${all.length} campus${all.length === 1 ? "" : "es"}${radiusNote}${state.origin && !radiusNote ? ", nearest first" : ""}`;
      noneEl.textContent = state.origin && state.radius > 0
        ? `No campuses within ${state.radius} miles. Try a wider radius.`
        : "No campuses match those filters. Try clearing the program filter or widening your search.";
      noneEl.classList.toggle("hidden", COMPACT || all.length > 0);

      if (map) {
        // Pins follow the filtered set, not the truncated card list — compact mode
        // shows no cards until there's an origin, but the map should still be full.
        const shown = new Set(all.map((c) => c.slug));
        Object.entries(markers).forEach(([slug, m]) => {
          if (shown.has(slug)) m.addTo(map);
          else map.removeLayer(m);
        });
        const forBounds = COMPACT && !state.origin ? all : list;
        const pts = forBounds.filter((c) => c.lat != null).map((c) => [c.lat, c.lng]);
        if (state.origin) pts.push([state.origin.lat, state.origin.lng]);
        if (pts.length) map.fitBounds(pts, { padding: [40, 40], maxZoom: state.origin ? 10 : 8 });
      }
    }

    function setPressed(container, attr, value) {
      container.querySelectorAll("button").forEach((b) => {
        const on = (b.getAttribute(attr) || "") === value;
        b.setAttribute("aria-pressed", String(on));
        b.className = on
          ? "rounded-full border min-h-11 sm:min-h-0 px-4 py-2.5 sm:py-1.5 text-sm sm:text-xs font-medium transition-colors border-teal-400 bg-teal-400 text-white"
          : "rounded-full border border-black/10 min-h-11 sm:min-h-0 px-4 py-2.5 sm:py-1.5 text-sm sm:text-xs font-medium text-ink hover:border-teal-300 transition-colors";
      });
    }

    $("#program-filter").addEventListener("click", (e) => {
      const b = e.target.closest("button"); if (!b) return;
      state.program = b.getAttribute("data-program") || "";
      setPressed($("#program-filter"), "data-program", state.program);
      render();
    });
    $("#state-filter").addEventListener("click", (e) => {
      const b = e.target.closest("button"); if (!b) return;
      state.stateCode = b.getAttribute("data-state") || "";
      setPressed($("#state-filter"), "data-state", state.stateCode);
      render();
    });

    async function useZip() {
      const raw = ($("#zip-input").value || "").trim();
      if (!/^\d{5}$/.test(raw)) {
        statusEl.textContent = "Enter a 5-digit ZIP code.";
        return;
      }
      statusEl.textContent = "Looking up that ZIP…";
      const zips = await loadZips();
      const hit = zips[raw];
      if (!hit) {
        statusEl.textContent = "We don't have that ZIP on file — try your current location instead.";
        return;
      }
      if (COMPACT) {
        window.location.href = `/our-schools/?zip=${raw}`;
        return;
      }
      state.origin = { lat: hit[0], lng: hit[1] };
      showRadius();
      statusEl.textContent = `Showing campuses nearest ${raw}.`;
      render();
    }
    const radiusSel = $("#radius-select");
    radiusSel?.addEventListener("change", () => {
      state.radius = Number(radiusSel.value) || 0;
      render();
    });
    function showRadius() { $("#radius-wrap")?.classList.remove("hidden"); }

    $("#zip-go").addEventListener("click", useZip);
    $("#zip-input").addEventListener("keydown", (e) => { if (e.key === "Enter") useZip(); });

    $("#geo-btn").addEventListener("click", () => {
      if (!navigator.geolocation) { statusEl.textContent = "Location isn't available in this browser."; return; }
      statusEl.textContent = "Finding your location…";
      navigator.geolocation.getCurrentPosition(
        (pos) => {
          state.origin = { lat: pos.coords.latitude, lng: pos.coords.longitude };
          showRadius();
          statusEl.textContent = "Showing campuses nearest you.";
          render();
        },
        (err) => {
          const why =
            err.code === 1 ? "Location permission was denied — you can re-enable it in your browser's site settings, or use a ZIP code."
          : err.code === 2 ? "Your location isn't available right now — try a ZIP code instead."
          : "Location timed out — try a ZIP code instead.";
          statusEl.textContent = why;
        },
        { timeout: 10000, maximumAge: 300000 }
      );
    });

    // Leaflet is bundled, so there is no third-party script at runtime.
    (async () => {
      const L = (await import("leaflet")).default;
      map = L.map("campus-map", { scrollWheelZoom: false }).setView([38.9, -77.2], 6);
      L.tileLayer("https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png", {
        attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a>',
        maxZoom: 18,
      }).addTo(map);
      const icon = L.divIcon({
        className: "",
        html: '<div style="width:26px;height:26px;border-radius:50%;background:#4A9B94;border:3px solid #fff;box-shadow:0 2px 6px rgba(0,0,0,.3)"></div>',
        iconSize: [26, 26], iconAnchor: [13, 13],
      });
      campuses.forEach((c) => {
        if (c.lat == null) return;
        markers[c.slug] = L.marker([c.lat, c.lng], { icon, title: c.name }).bindPopup(
          `<strong>${c.name}</strong><br>${c.city ? c.city + ", " + c.state : c.state}<br><a href="/${c.slug}/">View campus →</a>`
        );
      });
      render();
    })().catch(() => { $("#campus-map").style.display = "none"; });

    // Deep link from the home page: /our-schools/?zip=20151
    if (!COMPACT) {
      const qZip = new URLSearchParams(location.search).get("zip");
      if (qZip && /^\d{5}$/.test(qZip)) {
        const input = $("#zip-input");
        if (input) input.value = qZip;
        useZip();
      }
    }

    render();
  }
</script>
